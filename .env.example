# Supabase Configuration
# You can copy this file to .env.local and add your real Supabase project credentials.
# Alternatively, you can configure them directly inside the app using the "Configure DB" button.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
